# LLM Providers
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=

# YouTube Data API v3 — optional. Without it the video lessons still work via a
# scrape of the public results page, but embeddability cannot be checked in
# advance, so an occasional lesson will only open on youtube.com.
YOUTUBE_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/aividyarthi
REDIS_URL=redis://localhost:6379/0

# Confidence thresholds (externalized, not hardcoded)
RAG_CONFIDENCE_HIGH=0.85
RAG_CONFIDENCE_MEDIUM=0.40

# Model routing (task-complexity based)
MODEL_LIGHT=gemini-1.5-flash
MODEL_HEAVY=claude-3.5-sonnet
MODEL_VISION=gemini-1.5-flash

# Auth
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
RATE_LIMIT_PER_MIN=60

# Deepgram — server-side only. Proxied to the browser via /api/v1/voice/*;
# never expose this as a VITE_ var.
DEEPGRAM_API_KEY=
# Comma-separated browser origins allowed to use the voice relay.
ALLOWED_ORIGINS=http://localhost:5173
